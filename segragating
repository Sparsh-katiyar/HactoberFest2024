import java.io.*;
import java.util.*;

class Node {
    int data;
    Node next;
    Node(int data){
        this.data = data;
        next = null;
    }
}

class LinkedList {
    Node head;
    void add(int data){
        Node new_node = new Node(data);
        if(head == null){
            head = new_node;
            return;
        }
        Node current = head;
        while(current.next != null){
            current = current.next;
        }
        current.next = new_node;
    }
}

class Solution {
    static void unfold(Node head) {
        // Step 1: Count 0s, 1s, 2s
        int c0 = 0, c1 = 0, c2 = 0;
        Node temp = head;
        while(temp != null){
            if(temp.data == 0) c0++;
            else if(temp.data == 1) c1++;
            else c2++;
            temp = temp.next;
        }

        // Step 2: Refill the linked list
        temp = head;
        for(int i =0;i<c0;i++){
            temp.data = 0;
            temp = temp.next;
        }
      for(int i = 0;i<c1;i++){
            temp.data = 1;
            temp = temp.next;
        }
       for(int i =0;i<c2;i++){
            temp.data = 2;
            temp = temp.next;
        }

        // Step 3: Print result
        temp = head;
        while(temp != null){
            System.out.print(temp.data + " ");
            temp = temp.next;
        }
    }
}

public class Main {
    public static void main(String args[]) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        LinkedList l1 = new LinkedList();
        for(int i=0; i<n; i++){
            l1.add(sc.nextInt());
        }
        Solution Ob = new Solution();
        Ob.unfold(l1.head);
    }
}
